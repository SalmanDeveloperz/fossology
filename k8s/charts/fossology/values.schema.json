{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "user": {"type": "string", "minLength": 1},
        "password": {"type": "string"},
        "existingSecret": {"type": "string"}
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {"type": "string"},
            "storageClass": {"type": "string"}
          }
        },
        "resources": {"type": "object"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingClaim": {"type": "string"},
            "accessMode": {"enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"]},
            "size": {"type": "string"},
            "storageClass": {"type": "string"},
            "keep": {"type": "boolean"}
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backoffLimit": {"type": "integer", "minimum": 0},
        "resources": {"type": "object"}
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verbose": {"type": "integer", "minimum": 0},
        "localMaxAgents": {"type": "integer", "minimum": 1},
        "resources": {"type": "object"}
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"type": "integer", "minimum": 0},
        "maxAgents": {"type": "integer", "minimum": 1},
        "resources": {"type": "object"}
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {"type": "string"}
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "nodePort": {"type": ["integer", "null"], "minimum": 30000, "maximum": 32767},
            "sessionAffinity": {"enum": ["None", "ClientIP"]}
          }
        },
        "resources": {"type": "object"}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object"},
        "host": {"type": "string"},
        "tls": {"type": "array"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "podSecurityContext": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  }
}
